{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "emotionlens": {
      "root": ".",
      "entrypoint": "backend.app.main:app",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "emotionlens"
      }
    }
  ]
}
